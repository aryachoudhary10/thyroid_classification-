# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- run artifacts (regenerate; never version) ---
checkpoints/
results/
*.pt
*.pth

# --- Kaggle job outputs fetched locally (gigabytes) ---
# The bulk artefacts are excluded by kind rather than by job, so a new job's
# output directory is ignored automatically instead of being noticed after it
# has already been staged.
kaggle_jobs/**/out/
kaggle_jobs/**/out2/
kaggle_jobs/**/out3/
kaggle_jobs/**/out4/
kaggle_jobs/**/out_hires/
kaggle_jobs/**/_code/
kaggle_jobs/**/dermil_cache/
kaggle_jobs/**/registry/
kaggle_jobs/rcaf_ckpt/
kaggle_jobs/arms_out/
kaggle_jobs/verify_out/
kaggle_jobs/verify_rcaf/
*.log

# NOTE: the `results/` rule above also excludes kaggle_jobs/*/results/, which
# holds the result tables the paper reports. Those are small and cost GPU hours
# to regenerate, so if you want them versioned, add an exception here.

# --- generated: rebuild with `python kaggle_jobs/launch.py bundle` ---
kaggle_jobs/train/kernel_main.py
kaggle_jobs/code/src/

# --- credentials (never commit) ---
.kaggle/
kaggle.json
access_token

# --- misc ---
.DS_Store
Thumbs.db
