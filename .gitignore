# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# --- run artifacts (regenerate; never version) ---
checkpoints/
results/
*.pt
*.pth

# --- Kaggle job outputs fetched locally (gigabytes) ---
# Excluded by KIND, not by job, so a new job's output directory is ignored
# automatically. Note these are deliberately not whole-directory excludes of
# out/ or *_out/: git does not descend into an excluded directory, so the
# result tables and logs re-included below could never be reached.
kaggle_jobs/**/_code/
kaggle_jobs/**/dermil_cache/
kaggle_jobs/**/checkpoints/
kaggle_jobs/**/registry/
kaggle_jobs/rcaf_ckpt/

# ...but the result tables and session logs ARE versioned. They are a few MB,
# they are the numbers the paper reports, and regenerating them costs GPU
# hours. The directory negation must come before the contents negation.
!kaggle_jobs/**/results/
!kaggle_jobs/**/results/**
!kaggle_jobs/**/*.log
!kaggle_jobs/**/*.json
!kaggle_jobs/**/*.csv

# --- generated: rebuild with `python kaggle_jobs/launch.py bundle` ---
kaggle_jobs/train/kernel_main.py
kaggle_jobs/code/src/

# --- credentials (never commit) ---
.kaggle/
kaggle.json
access_token

# --- misc ---
.DS_Store
Thumbs.db
